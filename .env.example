# ==========================================
# Insight Copilot — Environment Configuration
# ==========================================

# 1. LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here (optional fallback)

# 2. Checkpointer Persistence (PostgreSQL on Neon.tech)
# If left empty, local in-memory checkpointing (MemorySaver) will be used automatically.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000,https://insight-copilot.vercel.app

# 4. Frontend Configuration (for frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
